name: Deploy Daily Baku

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Prepare SSH
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.VPS_SSH_KEY }}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -H "${{ secrets.VPS_HOST }}" >> ~/.ssh/known_hosts

      - name: Upload files to VPS
        run: |
          rsync -az --delete \
            --exclude='.git' \
            --exclude='.github' \
            --exclude='.env' \
            --exclude='.env.*' \
            --exclude='node_modules' \
            --exclude='backend/uploads' \
            --exclude='uploads' \
            --exclude='docker-compose.vps.yml' \
            -e "ssh -i ~/.ssh/deploy_key" \
            ./ "${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }}:${{ secrets.VPS_PATH }}/"

      - name: Rebuild and restart on VPS
        run: |
          ssh -i ~/.ssh/deploy_key "${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }}" 'bash -s' <<'EOF'
          set -e

          cd /var/www/dailybaku/app

          docker compose -f docker-compose.vps.yml --env-file .env up -d --build

          echo "Waiting for app to become ready..."

          for i in $(seq 1 40); do
            if curl -fsS http://127.0.0.1:3001/api/v1/ready; then
              echo
              echo "App is ready."
              docker compose -f docker-compose.vps.yml ps || true
              exit 0
            fi

            echo "Attempt $i/40: app not ready yet..."
            sleep 3
          done

          echo "App did not become ready in time. Showing logs:"
          docker compose -f docker-compose.vps.yml ps || true
          docker compose -f docker-compose.vps.yml logs app --tail=150 || true
          exit 1
          EOF