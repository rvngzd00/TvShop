NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Production üçün TVShop origin-lərini vergüllə ayırın.
ALLOWED_ORIGINS=
DATABASE_URL=postgresql://dailybaku:dailybaku@127.0.0.1:5432/dailybaku
# Docker PostgreSQL üçün disable. Xarici managed DB üçün require istifadə edin.
DATABASE_SSL=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-at-least-64-random-characters-before-production
COOKIE_SECRET=replace-with-an-independent-64-character-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
TRUST_PROXY=false
LOG_LEVEL=info
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800
DEFAULT_STORE_CODE=daily-baku
BOOTSTRAP_ADMIN_EMAIL=admin@gundelikbaki.az
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately
EMAIL_PROVIDER=disabled
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=TVShop <noreply@gundelikbaki.az>
EMAIL_REPLY_TO=support@gundelikbaki.az
EMAIL_TIMEOUT_MS=10000
# YouTube Data API v3 açarı yalnız serverdə istifadə olunur. Canlı yayım yoxlaması üçün tələb olunur.
YOUTUBE_API_KEY=
YOUTUBE_LIVE_CACHE_SECONDS=120
