{
  "name": "@daily-baku/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && NODE_ENV=test EMAIL_PROVIDER=disabled node --test dist/*.test.js dist/**/*.test.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-video-products": "tsx src/db/seed-video-products.ts",
    "db:audit-demo": "tsx src/db/demo-audit.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
